# --- LLM router ---
# Comma-separated ordered fallback chain. First provider whose key is set
# (and not "TODO_pending") is tried first; on 429/5xx/empty, router falls
# through to the next provider.
LLM_PROVIDER_ORDER=groq,gemini,nvidia,openrouter

# --- Groq ---
GROQ_API_KEY=TODO_set_me
GROQ_MODEL_DRAFT=llama-3.3-70b-versatile
GROQ_MODEL_SCORE=llama-3.1-8b-instant

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=PASTE_ME
GEMINI_MODEL_DRAFT=gemini-2.0-flash-exp
GEMINI_MODEL_SCORE=gemini-2.0-flash-exp

# --- NVIDIA NIM (OpenAI-compatible at integrate.api.nvidia.com/v1) ---
NVIDIA_API_KEY=PASTE_ME
NVIDIA_MODEL_DRAFT=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_SCORE=meta/llama-3.1-8b-instruct

# --- OpenRouter (OpenAI-compatible at openrouter.ai/api/v1) ---
OPENROUTER_API_KEY=PASTE_ME
OPENROUTER_MODEL_DRAFT=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_SCORE=meta-llama/llama-3.1-8b-instruct:free

# --- Hunter.io (email discovery used by handoff) ---
HUNTER_API_KEY=TODO_set_me

# --- Supabase / Postgres ---
# pooled connection string from Supabase > Project Settings > Database
DATABASE_URL=TODO_set_me
SUPABASE_URL=TODO_set_me
SUPABASE_ANON_KEY=TODO_set_me

# --- Telegram (approval queue) ---
TELEGRAM_BOT_TOKEN=TODO_set_me
TELEGRAM_CHAT_ID=TODO_set_me

# --- Reddit (karma-gated for 2 weeks on dave_fieldston) ---
# Leave as TODO_karma_gate; scraper + dispatch skip Reddit and log once.
REDDIT_CLIENT_ID=TODO_karma_gate
REDDIT_CLIENT_SECRET=TODO_karma_gate
REDDIT_USER_AGENT=ominvo-bot1/0.1 by dave_fieldston
REDDIT_USERNAME=dave_fieldston
REDDIT_PASSWORD=TODO_set_me

# --- Nitter (X mirror) ---
# comma-separated list; first healthy one wins
NITTER_INSTANCES=https://nitter.net,https://nitter.privacydev.net,https://nitter.poast.org

# --- Runtime flags ---
BOT1_DRY_RUN=false
BOT1_MAX_SIGNALS_PER_SOURCE=40
BOT1_MIN_INTENT_SCORE=65
LOG_LEVEL=INFO

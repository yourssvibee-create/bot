# Bot 7 — Local Business Lead Factory
# Strict per-bot isolation. This .env must live in bot7-maps-scraper/.
BOT_ID=bot7

# Reuse Bot 1 Supabase project; tables are prefixed bot7_ for isolation.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Reuse Bot 1 Hunter key.
HUNTER_API_KEY=

# Reuse Bot 1 Telegram bot + chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
BOT7_DRY_RUN=true
BOT7_HUNTER_CAP_PER_SEGMENT=40
BOT7_INTER_SEGMENT_SLEEP_S=30
BOT7_SCRAPE_CAP_PER_SEGMENT=120
BOT7_OUTPUT_DIR=output

# Phase 2: channel listers (empty = channel disabled, no attempt made).
BOT7_GUMROAD_ACCESS_TOKEN=
BOT7_PAYHIP_API_KEY=
BOT7_WHOP_API_KEY=
# Comma-separated subset. Blank = all channels whose creds are set.
BOT7_CHANNELS_ENABLED=
# A pack with fewer rows than this stays status=draft, never listed.
BOT7_MIN_RECORDS_FOR_READY=20
BOT7_SAMPLE_PACK_ROWS=10

LOG_LEVEL=INFO

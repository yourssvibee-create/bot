# Bot 7 — Local Business Lead Factory
# Strict per-bot isolation. This .env must live in bot7-maps-scraper/.
BOT_ID=bot7

# Reuse Bot 1 Supabase project; tables are prefixed bot7_ for isolation.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Reuse Bot 1 Hunter key.
HUNTER_API_KEY=

# Reuse Bot 1 Telegram bot + chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
BOT7_DRY_RUN=true
BOT7_HUNTER_CAP_PER_SEGMENT=40
BOT7_INTER_SEGMENT_SLEEP_S=30
BOT7_SCRAPE_CAP_PER_SEGMENT=120
BOT7_OUTPUT_DIR=output
LOG_LEVEL=INFO
